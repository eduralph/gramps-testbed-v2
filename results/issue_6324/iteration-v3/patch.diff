index 0000000000..56a246feac
--- /dev/null
+++ b/gramps/plugins/test/cairodoc_table_pagination_test.py
@@ -0,0 +1,344 @@
+#
+# Gramps - a GTK+/GNOME based genealogy program
+#
+# Copyright (C) 2026  Gramps developers
