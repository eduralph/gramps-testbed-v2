+++ b/gramps/gui/editors/editprimary.py
@@ -51,6 +51,7 @@ from ..dialog import SaveDialog
 from gramps.gen.lib import PrimaryObject
 from ..dbguielement import DbGUIElement
 from ..uimanager import ActionGroup
