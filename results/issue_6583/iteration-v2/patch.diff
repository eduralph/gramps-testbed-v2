diff --git a/gramps/plugins/test/toolbar_label_ellipsis_test.py b/gramps/plugins/test/toolbar_label_ellipsis_test.py
new file mode 100644
index 0000000000..5fcdb65315
--- /dev/null
+++ b/gramps/plugins/test/toolbar_label_ellipsis_test.py
@@ -0,0 +1,109 @@
+#
+# Gramps - a GTK+/GNOME based genealogy program
+#
+# Copyright (C) 2026  Gramps developers
+#
+# This program is free software; you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation; either version 2 of the License, or
+# (at your option) any later version.
+#
+# This program is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License along
+# with this program; if not, see <https://www.gnu.org/licenses/>.
+#
+
+"""
+Regression test for bug 6583.
+
+The list-view / category-view toolbar and its matching menu items used to
+label the Add / Edit / Merge actions with a trailing ellipsis ("_Add...",
+"Edit...", "_Merge...") while the Remove/Delete action carried none.  As the
+GNOME Human Interface Guidelines note (and Gramps maintainers agreed on the
+tracker), toolbar buttons "that correspond directly to menu items" should use
+"the text label the same as the menu item, but without any trailing ellipsis".
+The inconsistent ellipses were therefore removed from the Add/Edit/Merge action
+labels across the view definitions.
+
+This test parses the ``additional_ui`` UI-XML strings straight from each view's
+source file (no GTK / gramps.gui import, so it is headless-safe) and asserts
+that no Add/Edit/Merge action label keeps a trailing ellipsis.  It is RED before
+the fix (the ellipses are present) and GREEN after (they are stripped).
+"""
+
+import os
+import re
+import unittest
+
+# This file lives at gramps/plugins/test/<name>_test.py, so the gramps package
+# root is two directories up.  Resolve the view source files relative to it
+# instead of importing them (importing pulls in gramps.gui / gi → not headless).
+_GRAMPS_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
+
+# The category / list / relationship views whose toolbars carried the action
+# buttons reported in bug 6583.
+VIEW_FILES = [
+    "plugins/lib/libpersonview.py",
+    "plugins/lib/libplaceview.py",
+    "plugins/view/citationlistview.py",
+    "plugins/view/citationtreeview.py",
+    "plugins/view/eventview.py",
+    "plugins/view/familyview.py",
+    "plugins/view/mediaview.py",
+    "plugins/view/noteview.py",
+    "plugins/view/repoview.py",
+    "plugins/view/sourceview.py",
+    "plugins/view/relview.py",
+]
+
+# A GtkToolButton <property name="label">…</property> or a menu/popup
+# <attribute name="label">…</attribute> value.  DOTALL so a label split across
+# Python string concatenation is captured as one value too.
+_LABEL_RE = re.compile(
+    r'name="label"(?:\s+translatable="[^"]*")?\s*>([^<]*)<', re.DOTALL
+)
+# Labels supplied through sgettext, e.g.  _("_Edit...", "action").
+_SGETTEXT_RE = re.compile(r'_\(\s*"([^"]*)"\s*,\s*"action"\s*\)')
+
+# The Add / Edit / Merge action family (covers "_Add", "Edit...", "_Merge...",
+# "Add source...", "Add Partner...", "Add New Parents...", …).  Remove/Delete is
+# deliberately excluded — it never carried an ellipsis.
+_ACTION_FAMILY = re.compile(r"(Add|Edit|Merge|Partner)")
+
+
+def _iter_action_labels(text):
+    """Yield every Add/Edit/Merge-family label string defined in *text*."""
+    for value in _LABEL_RE.findall(text):
+        if _ACTION_FAMILY.search(value):
+            yield value
+    for value in _SGETTEXT_RE.findall(text):
+        if _ACTION_FAMILY.search(value):
+            yield value
+
+
+class ToolbarLabelEllipsisTest(unittest.TestCase):
+    """Bug 6583: Add/Edit/Merge toolbar+menu labels must not end with '...'."""
+
+    def test_no_trailing_ellipsis_on_action_labels(self):
+        offenders = []
+        for rel in VIEW_FILES:
+            path = os.path.join(_GRAMPS_ROOT, rel)
+            with open(path, encoding="utf-8") as handle:
+                text = handle.read()
+            for label in _iter_action_labels(text):
+                if label.endswith("..."):
+                    offenders.append("%s: %r" % (rel, label))
+        self.assertEqual(
+            offenders,
+            [],
+            "Add/Edit/Merge toolbar/menu labels still carry a trailing "
+            "ellipsis (bug 6583):\n  " + "\n  ".join(offenders),
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
