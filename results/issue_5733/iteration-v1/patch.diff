new file mode 100644
index 0000000..993ed4e
--- /dev/null
+++ b/gramps/plugins/test/odfdoc_drawscale_test.py
@@ -0,0 +1,192 @@
+#
+# Gramps - a GTK+/GNOME based genealogy program
+#
+# Copyright (C) 2026  Gramps developers
