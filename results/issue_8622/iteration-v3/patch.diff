+# -------------------------------------------------------------------------
+#
+# _SourceGroupSearchFilter
+#
+# -------------------------------------------------------------------------
+class _SourceGroupSearchFilter:
+    """
+    Group a hierarchical source->citation text search *by source* (issue 8622).
+
+    The base :class:`CitationTreeModel` applies the text search to the secondary
+    (citation) rows by the *same* column as the primary (source) rows.  On the
+    Title/Volume-Page column that means a citation is kept only when its own
+    page contains the search text -- which, for a search that matches a *source
+    title*, is almost never true -- so a matched source is shown with none of
+    its citations, and the "Select Source or Citation" selector forces the user
+    to create a *new* citation instead of reusing an existing one.
+
+    This filter restores the reachability invariant: a source -- and *every* one
+    of its citations -- is shown when the source's title matches the primary
+    search OR any of the source's citations match the secondary search.  So a
+    citation stays reachable whenever its parent source is shown, whether the
+    source was kept because its title matched or because one of its citations
+    matched (its siblings stay reachable too).
+
+    Both the set of shown source handles is computed **once**, from a single
+    pass over the source cursor (title matches) and a single pass over the
+    citation cursor (sources owning a matching citation), and cached in the
+    ``shared`` dict that the primary and secondary instances hold in common.
+    Matching is then a set-membership test.  Crucially, the source search
+    filter is only ever run against handles yielded by the *source* cursor
+    (always live), and the citation cursor only supplies ``source_handle``
+    values that are *added to a set* (never dereferenced), so an orphan
+    citation whose ``source_handle`` points at a deleted source never triggers
+    a ``get_raw_source_data`` on a missing handle during the search -- the
+    handle simply fails the membership test and the citation is hidden (its
+    source no longer exists, so it cannot be shown).
+    """
+
+    def __init__(
+        self,
+        source_filter,
+        citation_filter,
+        source_cursor,
+        citation_cursor,
+        get_source_handle,
+        secondary,
+        shared,
+    ):
+        self._source_filter = source_filter
+        self._citation_filter = citation_filter
+        self._source_cursor = source_cursor
+        self._citation_cursor = citation_cursor
+        self._get_source_handle = get_source_handle
+        self._secondary = secondary
+        self._shared = shared
+
+    def _shown_sources(self, db):
+        """
+        Set of source handles that must be shown: those whose title matches the
+        primary search, plus those owning at least one citation matching the
+        secondary search.  Computed once and cached in ``shared``.
+        """
+        shown = self._shared.get("shown")
+        if shown is None:
+            shown = set()
+            # Sources whose own (title) column matches -- handles come from the
+            # source cursor, so they are always live.
+            if self._source_filter is not None:
+                with self._source_cursor() as cursor:
+                    for handle, _data in cursor:
+                        if self._source_filter.match(handle, db):
+                            shown.add(handle)
+            # Sources owning a citation whose (page) column matches -- the
+            # source handle is only added to the set, never dereferenced, so a
+            # dangling source_handle cannot raise here.
+            if self._citation_filter is not None:
+                with self._citation_cursor() as cursor:
+                    for handle, data in cursor:
+                        if self._citation_filter.match(handle, db):
+                            shown.add(data.source_handle)
+            self._shared["shown"] = shown
+        return shown
+
+    def match(self, handle, db):
+        """
+        For a primary (source) row ``handle`` is the source handle; for a
+        secondary (citation) row it is the citation handle, mapped to its parent
+        source so all citations of a shown source stay reachable.
+        """
+        shown = self._shown_sources(db)
+        if self._secondary:
+            return self._get_source_handle(handle) in shown
+        return handle in shown
+
+
+# -------------------------------------------------------------------------
+#
+# CitationTreeSelectorModel
+#
+# -------------------------------------------------------------------------
+class CitationTreeSelectorModel(CitationTreeModel):
+    """
+    Citation tree model for the "Select Source or Citation" selector.
+
+    Identical to :class:`CitationTreeModel` except that a text search is grouped
+    by source (see :class:`_SourceGroupSearchFilter`): a source kept by the
+    search keeps *all* of its existing citations reachable, so the user can
+    reuse one instead of being forced to create a new citation (issue 8622).
+
+    The standalone Citation Tree View keeps :class:`CitationTreeModel`'s
+    independent secondary search, so its behaviour is unchanged.
+    """
+
+    def set_search(self, search):
+        """
+        See :meth:`TreeBaseModel.set_search`.  After the base builds the
+        independent primary (source) and secondary (citation) search filters,
+        widen a plain text search so it is grouped by source (issue 8622).
+        """
+        super().set_search(search)
+        # Only widen a plain text search that carries data:
+        #  * ``search`` falsy or ``search[1]`` falsy  -> search cleared;
+        #  * ``search[0]`` truthy                     -> a sidebar GenericFilter
+        #                                                (out of scope).
+        # In those cases the base filters (which may be None) are left intact.
+        if (
+            search
+            and not search[0]
+            and search[1]
+            and self.search is not None
+            and self.search2 is not None
+        ):
+            shared = {}
+            source_filter = self.search
+            citation_filter = self.search2
+            self.search = _SourceGroupSearchFilter(
+                source_filter,
+                citation_filter,
+                self.gen_cursor,
+                self.gen_cursor2,
+                self._citation_source_handle,
+                secondary=False,
+                shared=shared,
+            )
+            self.search2 = _SourceGroupSearchFilter(
+                source_filter,
+                citation_filter,
+                self.gen_cursor,
+                self.gen_cursor2,
+                self._citation_source_handle,
+                secondary=True,
+                shared=shared,
+            )
+            self.current_filter = self.search
+            self.current_filter2 = self.search2
+
+    def _citation_source_handle(self, citation_handle):
+        """Return the source handle a citation belongs to."""
+        return self.map2(citation_handle).source_handle
