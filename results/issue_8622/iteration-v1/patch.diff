+
+"""
+Regression test for issue 8622.
+
+In the "Select Source or Citation" selector the source->citation tree lets
+you expand a source and pick one of its existing citations.  As soon as a
+text search is typed, the secondary (citation) rows are filtered by the *same*
+column and text as the primary (source) rows.  For a search on the
+title/page column that drops every citation of a matched source (a citation's
+page rarely contains the source title), so the source is shown but has no
+citation children -- the user is forced to create a *new* citation.
+
+This test drives the production model-build path -- ``CitationTreeModel`` with
+a ``search=`` tuple -- against a lightweight in-memory database and asserts on
+the resulting node map:
+
+* Without the selector option (the standalone Citation Tree View behaviour),
+  a search matching a source drops its citations -- the documented bug, and
+  the behaviour the fix must NOT change for the standalone view.
+* With ``match_child_via_parent=True`` (what the selector passes), the matched
+  source keeps its existing citations reachable as child rows.
+
+The model imports :mod:`gi.repository.Gtk`, but building the model with a
+handful of rows never pops a progress dialog (the estimated time stays below
+the popup threshold), so this runs headless.
+"""
+
+import unittest
+from contextlib import contextmanager
+
+from ..citationtreemodel import CitationTreeModel
+
+
+# -------------------------------------------------------------------------
+#
+# Lightweight in-memory test doubles
+#
+# -------------------------------------------------------------------------
+class _Source:
+    """Raw source data as the model's ``fmap``/sort funcs read it."""
+
+    def __init__(self, handle, gramps_id, title):
+        self.handle = handle
+        self.gramps_id = gramps_id
+        self.title = title
+        self.author = ""
+        self.abbrev = ""
+        self.pubinfo = ""
+        self.private = False
+        self.tag_list = []
+        self.change = 0
+
+
+class _Citation:
+    """Raw citation data as the model's ``fmap2``/sort funcs read it."""
+
+    def __init__(self, handle, gramps_id, page, source_handle):
+        self.handle = handle
+        self.gramps_id = gramps_id
+        self.page = page
+        self.source_handle = source_handle
+        self.date = None
+        self.confidence = 0
+        self.private = False
+        self.tag_list = []
+        self.change = 0
+
+
+class _FakeDb:
+    """Minimal database exposing only what CitationTreeModel touches."""
+
+    def __init__(self, sources, citations):
+        self._sources = {s.handle: s for s in sources}
+        self._citations = {c.handle: c for c in citations}
+
+    def is_open(self):
+        return True
+
+    # --- sources (primary) ---
+    def get_number_of_sources(self):
+        return len(self._sources)
+
+    def get_raw_source_data(self, handle):
+        return self._sources[handle]
+
+    def get_source_cursor(self):
+        return self._cursor(self._sources)
+
+    # --- citations (secondary) ---
+    def get_number_of_citations(self):
+        return len(self._citations)
+
+    def get_raw_citation_data(self, handle):
+        return self._citations[handle]
+
+    def get_citation_cursor(self):
+        return self._cursor(self._citations)
+
+    @staticmethod
+    @contextmanager
+    def _cursor(mapping):
+        yield list(mapping.items())
+
+
+# -------------------------------------------------------------------------
+#
+# The test
+#
+# -------------------------------------------------------------------------
+class CitationSelectorSearchTest(unittest.TestCase):
+    """Issue 8622 -- searched source must keep its citations reachable."""
+
+    def setUp(self):
+        # Two sources; only "Holy Bible" matches a search for "Bible".
+        self.src_bible = "SRC_BIBLE"
+        self.src_news = "SRC_NEWS"
+        sources = [
+            _Source(self.src_bible, "S0001", "Holy Bible"),
+            _Source(self.src_news, "S0002", "Daily Newspaper"),
+        ]
+        # Two citations under the matching source, one under the other. None
+        # of the pages contain the search text, so the old same-column filter
+        # drops them all.
+        citations = [
+            _Citation("CIT_B1", "C0001", "p.10", self.src_bible),
+            _Citation("CIT_B2", "C0002", "p.20", self.src_bible),
+            _Citation("CIT_N1", "C0003", "col.3", self.src_news),
+        ]
+        self.db = _FakeDb(sources, citations)
+        # uistate is only stashed by the (non-popping) progress monitor.
+        self.uistate = object()
+        # Column 0 = "Source: Title or Citation: Volume/Page"; text search,
+        # not a GenericFilter, not exact:  (filter?, (col, text, inv), exact?)
+        self.search = (False, (0, "Bible", False), False)
+
+    def _child_handles(self, model, source_handle):
+        """Handles of the citation rows under ``source_handle`` in the model."""
+        node = model.tree.get(source_handle)
+        if node is None:
+            return []
+        return [model.nodemap.node(nid).handle for _sortkey, nid in node.children]
+
+    def test_selector_keeps_citations_of_matched_source(self):
+        """
+        With the selector option, a source kept by the search still exposes
+        its existing citations as child rows (the fix).
+        """
+        model = CitationTreeModel(
+            self.db,
+            self.uistate,
+            search=self.search,
+            match_child_via_parent=True,
+        )
+        try:
+            # The matching source is shown...
+            self.assertIn(
+                self.src_bible,
+                model.tree,
+                "matched source should be present in the tree",
+            )
+            # ...with BOTH of its existing citations reachable under it.
+            self.assertEqual(
+                sorted(self._child_handles(model, self.src_bible)),
+                ["CIT_B1", "CIT_B2"],
+                "existing citations of the matched source must stay reachable",
+            )
+            # The non-matching source (and its citation) stays filtered out.
+            self.assertNotIn(self.src_news, model.tree)
+        finally:
+            model.destroy()
+
+    def test_default_search_drops_citations(self):
+        """
+        Without the selector option the standalone Citation Tree View
+        behaviour is unchanged: the same-column search drops the matched
+        source's citations.  This documents the bug and pins the scope of the
+        fix (the standalone view must not regress).
+        """
+        model = CitationTreeModel(
+            self.db,
+            self.uistate,
+            search=self.search,
+        )
+        try:
+            self.assertIn(self.src_bible, model.tree)
+            self.assertEqual(
+                self._child_handles(model, self.src_bible),
+                [],
+                "default (non-selector) search still filters citations by page",
+            )
+        finally:
+            model.destroy()
+
+
+if __name__ == "__main__":
+    unittest.main()
