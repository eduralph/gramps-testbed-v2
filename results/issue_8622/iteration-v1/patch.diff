 from .citationbasemodel import CitationBaseModel
 
 
+# -------------------------------------------------------------------------
+#
+# SourceOrCitationSearchFilter
+#
+# -------------------------------------------------------------------------
+class SourceOrCitationSearchFilter:
+    """
+    Secondary-row search filter for the "Select Source or Citation" selector.
+
+    In a hierarchical source->citation tree a plain text search filters the
+    secondary (citation) rows by the *same* column and text as the primary
+    (source) rows.  For a search on the title/page column that drops every
+    citation of a matched source (a citation's page rarely contains the source
+    title), leaving the source expandable but empty -- the user is then forced
+    to create a *new* citation instead of reusing an existing one (issue 8622).
+
+    This filter keeps a citation reachable when *either* the citation itself
+    matches the citation search *or* its parent source matches the source
+    search.  So a source that the search retains keeps its existing citations
+    selectable, while the independent citation search is preserved.
+    """
+
+    def __init__(self, citation_filter, source_filter, get_source_handle):
+        self.citation_filter = citation_filter
+        self.source_filter = source_filter
+        self.get_source_handle = get_source_handle
+
+    def match(self, handle, db):
+        """
+        Return True if the citation matches, or if its parent source (which is
+        shown by the primary search) does -- so the source's citations stay
+        reachable under it.
+        """
+        if self.citation_filter is not None and self.citation_filter.match(handle, db):
+            return True
+        if self.source_filter is not None:
+            source_handle = self.get_source_handle(handle)
+            if source_handle:
+                return self.source_filter.match(source_handle, db)
+        return False
+
+
