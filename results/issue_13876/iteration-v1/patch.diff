+# with this program; if not, see <https://www.gnu.org/licenses/>.
+#
+
+"""
+Headless regression test for Mantis 13876.
+
+In the Sources category's *Citation Tree* view mode, deleting a selected
+Citation row did nothing -- the citation stayed in the database.  The cause
+was in ``LibSourceView.remove_object_from_handle`` (the delete handler shared
+by SourceView and CitationTreeView): after cleaning up back-references it
+unconditionally called ``remove_source`` on the selected handle, so when the
+handle belonged to a Citation the object was never removed.
+
+This exercises the production delete handler directly (no Gtk/GUI import,
+so it runs under the headless unit runner) and asserts that deleting a
+citation handle actually removes the citation -- the same effect the flat
+Citation list view's delete produces.
+"""
+
+# -------------------------------------------------------------------------
+#
+# Standard python modules
+#
+# -------------------------------------------------------------------------
+import unittest
+
+# -------------------------------------------------------------------------
+#
+# Gramps modules
+#
+# -------------------------------------------------------------------------
+from gramps.gen.db import DbTxn
+from gramps.gen.db.utils import make_database
+from gramps.gen.lib import Source, Citation
+
+# The module under test imports only gramps.gen.errors -- no gi / gramps.gui --
+# so it is safe to import in the headless runner.
+from gramps.plugins.lib.libsourceview import LibSourceView
+
+
+class _Dbstate:
+    """Minimal stand-in for the DbState the view normally holds."""
+
+    def __init__(self, db):
+        self.db = db
+
+
+class CitationTreeDeleteTest(unittest.TestCase):
+    """
+    Deleting a selected Citation row in the Citation Tree view must remove
+    that citation from the database.
+    """
+
+    def setUp(self):
+        self.db = make_database("sqlite")
+        self.db.load(":memory:")
+        with DbTxn("Add source and citation", self.db) as trans:
+            source = Source()
+            self.source_handle = self.db.add_source(source, trans)
+            citation = Citation()
+            citation.set_reference_handle(self.source_handle)
+            self.citation_handle = self.db.add_citation(citation, trans)
+
+    def tearDown(self):
+        self.db.close()
+
+    def _make_view(self):
+        # LibSourceView is a plain mixin with no __init__; build the handler
+        # and give it the db state the production code reads.
+        view = LibSourceView()
+        view.dbstate = _Dbstate(self.db)
+        return view
+
+    def test_citation_row_delete_removes_citation(self):
+        """A selected citation handle is actually deleted from the DB."""
+        view = self._make_view()
+        self.assertTrue(self.db.has_citation_handle(self.citation_handle))
+
+        with DbTxn("Delete citation", self.db) as trans:
+            view.remove_object_from_handle(
+                "Citation", self.citation_handle, trans, in_use_prompt=False
+            )
+
+        self.assertFalse(
+            self.db.has_citation_handle(self.citation_handle),
+            "Citation Tree view delete must remove the selected citation",
+        )
+        # The parent source is out of scope and must remain untouched.
+        self.assertTrue(self.db.has_source_handle(self.source_handle))
+
+
+if __name__ == "__main__":
+    unittest.main()
