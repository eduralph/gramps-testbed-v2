+# with this program; if not, see <https://www.gnu.org/licenses/>.
+#
+
+"""
+Unit tests for the gramplet column-count bound (Mantis 13864).
+
+The Dashboard "Number of Columns" control accepts any positive integer, and
+that value drives GTK widget allocation in ``GrampletPane``. An unbounded value
+freezes Gramps and then crashes it, leaving the family tree locked. These tests
+exercise the validation helper the production paths route through
+(``GrampletPane.__init__``, ``load_gramplets`` and ``set_columns`` all call
+``clamp_column_count``) -- without importing any GUI/``gi`` module, so they run
+under the headless test runner.
+"""
+
+import unittest
+
+from gramps.gui.grampletconfig import MAX_GRAMPLET_COLUMNS, clamp_column_count
+
+
+class ClampColumnCountTest(unittest.TestCase):
+    """Any accepted column value must yield a bounded, survivable count."""
+
+    def test_reasonable_values_pass_through(self):
+        for value in (1, 2, 3, MAX_GRAMPLET_COLUMNS):
+            self.assertEqual(clamp_column_count(value), value)
+
+    def test_zero_and_negative_raise_to_one(self):
+        for value in (0, -1, -1000):
+            self.assertEqual(clamp_column_count(value), 1)
+
+    def test_large_values_are_capped(self):
+        # The reporter's 1000 and any pathological value must be bounded so the
+        # layout never grows unboundedly.
+        for value in (1000, 200000, 10**9):
+            self.assertEqual(clamp_column_count(value), MAX_GRAMPLET_COLUMNS)
+
+    def test_string_values_from_ini_are_accepted(self):
+        # load_gramplets() reads the saved value as a string.
+        self.assertEqual(clamp_column_count("2"), 2)
+        self.assertEqual(clamp_column_count("1000"), MAX_GRAMPLET_COLUMNS)
+
+    def test_clamped_count_bounds_widget_allocation(self):
+        # GrampletPane allocates one column box per ``range(column_count)``; the
+        # clamp must keep that allocation bounded for ANY accepted value, which
+        # is what keeps the process from freezing/crashing.
+        for value in (1000, 200000, 10**9):
+            allocated = len(range(clamp_column_count(value)))
+            self.assertLessEqual(allocated, MAX_GRAMPLET_COLUMNS)
+            self.assertGreaterEqual(allocated, 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
