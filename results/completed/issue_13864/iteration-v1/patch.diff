+
+"""
+Validation helpers for the gramplet view layout.
+
+This module deliberately imports nothing from :mod:`gi` or :mod:`gramps.gui`
+so the column-count bound can be unit tested without a display.
+"""
+
+# Upper bound on the number of gramplet columns the Dashboard will build.
+#
+# The configured column count drives GTK widget allocation directly:
+# ``GrampletPane`` builds one container box per column and lays the gramplets
+# out across them. A user-supplied count is otherwise unbounded, so a large
+# value (the reporter used 1000) makes Gramps allocate an enormous layout,
+# freeze ("Not responding"), and then get killed -- which leaves the family
+# tree locked because the database lock is never released. The ceiling is a
+# safety limit, far above any practical Dashboard layout.
+MAX_GRAMPLET_COLUMNS = 100
+
+
+def clamp_column_count(num):
+    """
+    Constrain a requested gramplet column count to a survivable range.
+
+    The value may come from a user keystroke in the configuration dialog, from
+    a saved ``.ini`` file (where it is stored as a string), or from a default,
+    so it is coerced to ``int`` and bounded to ``[1, MAX_GRAMPLET_COLUMNS]``
+    before it is ever used to allocate column widgets.
+
+    :param num: requested column count (``int`` or numeric ``str``)
+    :returns: a column count in ``[1, MAX_GRAMPLET_COLUMNS]``
+    :rtype: int
+    """
+    return min(max(int(num), 1), MAX_GRAMPLET_COLUMNS)
