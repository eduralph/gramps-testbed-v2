diff --git a/.github/scripts/tests/test_addon_system_deps.py b/.github/scripts/tests/test_addon_system_deps.py
new file mode 100644
index 000000000..1492375e5
--- /dev/null
+++ b/.github/scripts/tests/test_addon_system_deps.py
@@ -0,0 +1,161 @@
+#!/usr/bin/env python3
+"""Source-built addon deps must be buildable in CI — never a silent skip.
+
+Regression test for the build-toolchain coverage gap (addons-source PR #820):
+the CI image purged the build toolchain (gcc/python3-dev/pkg-config) after the
+Gramps install, and the per-package -dev headers a source-built ``requires_mod``
+links against were not provisioned anywhere. So ``pip install pygraphviz`` /
+``psycopg2`` failed at CI runtime, the failure was swallowed by the install
+step's ``|| echo … (continuing)``, and the affected addon's unit suite skipped
+while the job stayed green — silent coverage loss reported as success.
+
+The fix restores the invariant *declared addon dependencies are honestly
+satisfied or honestly skipped*: every source-built ``requires_mod`` an addon
+declares must have its build header derived from the single-source map
+(``addon_system_deps.MOD_BUILD_PACKAGES`` → installed by ci.yml's "Install addon
+system deps" step) AND the compiler toolchain that compiles it must remain in
+the CI image (``.github/docker/gramps-ci/Dockerfile`` no longer purges it).
+
+Pure stdlib / no ``gi`` / no ``gramps.gui`` imports, so it runs under the
+headless C4 runner. It exercises the production derivation path (the same
+``packages()`` / CLI that ci.yml calls), not a copy of it.
+"""
+
+# ------------------------
+# Python modules
+# ------------------------
+from __future__ import annotations
+
+import ast
+import glob
+import io
+import os
+import re
+import sys
+import unittest
+from contextlib import redirect_stdout
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+_SCRIPTS = os.path.dirname(_HERE)  # .github/scripts
+_REPO_ROOT = os.path.dirname(os.path.dirname(_SCRIPTS))  # repo root (above .github)
+_DOCKERFILE = os.path.join(_REPO_ROOT, ".github", "docker", "gramps-ci", "Dockerfile")
+
+sys.path.insert(0, _SCRIPTS)
+import addon_system_deps as deps  # noqa: E402
+
+# The requires_mod that are built from source in CI (no wheel for the image's
+# Python/arch) and so need a system -dev header. Kept here as the test's own
+# statement of the category, independent of the production map, so a regression
+# that drops an entry from MOD_BUILD_PACKAGES is caught rather than mirrored.
+_SOURCE_BUILT_MODS = ("pygraphviz", "psycopg2")
+
+_REQUIRES_MOD_RE = re.compile(r"requires_mod\s*=\s*(\[[^\]]*\])")
+
+
+def _declared_requires_mod() -> set[str]:
+    """Union of requires_mod across every .gpr.py in the repo (as ci.yml derives)."""
+    mods: set[str] = set()
+    for path in glob.glob(os.path.join(_REPO_ROOT, "*", "*.gpr.py")):
+        try:
+            with open(path, encoding="utf-8") as fh:
+                text = fh.read()
+        except OSError:
+            continue
+        for match in _REQUIRES_MOD_RE.finditer(text):
+            try:
+                mods.update(ast.literal_eval(match.group(1)))
+            except (ValueError, SyntaxError):
+                pass
+    return mods
+
+
+class SourceBuiltModBuildDeps(unittest.TestCase):
+    """The apt install list must carry every source-built requires_mod's header."""
+
+    def test_known_source_built_mods_are_declared_by_some_addon(self):
+        # Grounds the rest of the suite in real declarations: if these addons
+        # ever drop the dep this test would otherwise pass vacuously.
+        declared = _declared_requires_mod()
+        for mod in _SOURCE_BUILT_MODS:
+            self.assertIn(
+                mod,
+                declared,
+                f"expected some addon's .gpr.py to declare requires_mod={mod!r}",
+            )
+
+    def test_packages_apt_includes_build_headers(self):
+        apt = deps.packages("apt")
+        for mod in _SOURCE_BUILT_MODS:
+            pkg = deps.MOD_BUILD_PACKAGES.get(mod, {}).get("apt")
+            self.assertIsNotNone(
+                pkg,
+                f"source-built requires_mod {mod!r} has no apt build package in "
+                "MOD_BUILD_PACKAGES — its CI pip build will fail for a missing header",
+            )
+            self.assertIn(
+                pkg,
+                apt,
+                f"{pkg!r} (build header for {mod!r}) missing from packages('apt'); "
+                "ci.yml would not install it and the source build would be silently skipped",
+            )
+
+    def test_cli_apt_emits_build_headers(self):
+        # Exercise the exact production entry point ci.yml calls:
+        #   pkgs=$(python3 addon_system_deps.py --platform apt)
+        buf = io.StringIO()
+        with redirect_stdout(buf):
+            rc = deps.main(["--platform", "apt"])
+        self.assertEqual(rc, 0)
+        emitted = buf.getvalue().split()
+        self.assertIn("libgraphviz-dev", emitted)
+        self.assertIn("libpq-dev", emitted)
+
+    def test_every_declared_source_built_mod_is_provisioned(self):
+        # Category guard: any source-built requires_mod an addon declares must be
+        # mapped AND surfaced, so a newly added one cannot silently lose coverage.
+        apt = set(deps.packages("apt"))
+        for mod in _declared_requires_mod() & set(_SOURCE_BUILT_MODS):
+            pkg = deps.MOD_BUILD_PACKAGES[mod]["apt"]
+            self.assertIn(pkg, apt)
+
+
+class CiImageKeepsBuildToolchain(unittest.TestCase):
+    """The image must keep the compiler toolchain those headers are used by."""
+
+    @classmethod
+    def setUpClass(cls):
+        with open(_DOCKERFILE, encoding="utf-8") as fh:
+            cls.lines = [
+                ln
+                for ln in fh.read().splitlines()
+                if ln.strip() and not ln.lstrip().startswith("#")
+            ]
+
+    def test_toolchain_not_purged(self):
+        # The defect was a `RUN apt-get purge -y gcc python3-dev pkg-config`
+        # after the Gramps install, removing the compiler before CI-runtime
+        # source builds run.
+        for line in self.lines:
+            if "apt-get purge" in line or "apt-get remove" in line:
+                for tool in ("gcc", "pkg-config", "python3-dev"):
+                    self.assertNotIn(
+                        tool,
+                        line,
+                        f"Dockerfile purges build toolchain ({tool!r}) — "
+                        "CI-runtime source builds of requires_mod will have no compiler:\n"
+                        f"    {line.strip()}",
+                    )
+
+    def test_toolchain_is_installed(self):
+        text = "\n".join(self.lines)
+        for tool in ("gcc", "pkg-config"):
+            self.assertIn(
+                tool,
+                text,
+                f"Dockerfile no longer installs {tool!r}; source-built requires_mod "
+                "cannot compile in CI",
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
