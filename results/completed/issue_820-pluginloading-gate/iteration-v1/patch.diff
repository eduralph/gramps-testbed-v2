+"""
+Gating policy for the addon plugin-load CI check.
+
+Extracted from :mod:`tests.test_plugin_registration` so the *gating decision*
+— which load outcomes block CI and which are merely advisory — has one
+implementation that both production (``TestPluginLoading.test_load_all_addon_modules``)
+and its regression test exercise, and so the decision can be unit-tested
+without booting the full Gramps plugin environment.
+
+The policy: a **hard failure** (an addon that fails to load with no
+environmental excuse — not a missing declared dependency, not a subprocess
+crash) gates the CI run, exactly as the sibling smoke tests
+(``TestImportPluginSmoke`` / ``TestExportPluginSmoke``) ``self.fail`` on their
+findings. Dependency skips and subprocess crashes (typically a missing display
+server in CI) stay advisory and are reported by the caller as warnings.
+
+This module imports nothing from ``gi`` or ``gramps.gui`` so it stays loadable
+in a headless test runner.
+"""
+
+# ------------------------
+# Python modules
+# ------------------------
+from __future__ import annotations
+
+
+def hard_load_failure_message(hard_failures: list[str]) -> str | None:
+    """Return the CI-gating failure message for a load run, or ``None``.
+
+    :param hard_failures: Descriptions of addons that failed to load with no
+                          environmental excuse (not a missing dependency, not a
+                          crashing subprocess).
+    :type hard_failures: list[str]
+    :returns: A human-readable failure message when ``hard_failures`` is
+              non-empty (so the caller must fail the test), else ``None``.
+    :rtype: str | None
+    """
+    if not hard_failures:
+        return None
+    return f"{len(hard_failures)} addon(s) failed to load:\n  " + "\n  ".join(
+        hard_failures
+    )
