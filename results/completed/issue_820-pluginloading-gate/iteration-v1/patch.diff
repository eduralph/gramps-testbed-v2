+# ------------------------------------------------------------
+#
+# TestPluginLoadingGate
+#
+# ------------------------------------------------------------
+class TestPluginLoadingGate(unittest.TestCase):
+    """The load check must *gate* on non-dependency failures, not just log them.
+
+    Regression guard for addons-source PR #820 finding R-C:
+    ``TestPluginLoading.test_load_all_addon_modules`` named ``hard_failures``
+    but only ``LOG.warning``-ed them, so a genuine non-dependency load failure
+    passed silently — its sole assertion was ``assertGreater(len(plugins), 0)``.
+
+    The gating verdict now lives in
+    :func:`tests.plugin_load_gate.hard_load_failure_message`, which
+    ``test_load_all_addon_modules`` routes through, so these cases drive the
+    exact decision the production test uses — not a copy of it. This case is
+    import-light (no ``gi`` / ``gramps.gui``) so it runs in a headless runner.
+    """
+
+    def test_hard_failure_gates(self) -> None:
+        """A synthetic non-dependency load failure must produce a fail message.
+
+        With the silent-warning behaviour, no message would be produced and
+        ``test_load_all_addon_modules`` would still pass; the gate must instead
+        yield a message that the production test turns into ``self.fail``.
+        """
+        message = hard_load_failure_message(
+            ["fake_addon (ModuleNotFoundError: No module named 'no_such_module')"]
+        )
+        self.assertIsNotNone(
+            message,
+            "a non-dependency load failure must gate the run, not pass silently",
+        )
+        self.assertIn("fake_addon", message)
+        self.assertIn("failed to load", message)
+
+    def test_clean_run_does_not_gate(self) -> None:
+        """No hard failures → no gating message, so a clean run still passes."""
+        self.assertIsNone(hard_load_failure_message([]))
+
+
 if __name__ == "__main__":
     unittest.main()
