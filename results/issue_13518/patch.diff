+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License along
+# with this program; if not, see <https://www.gnu.org/licenses/>.
+#
+
+"""
+Helpers for :mod:`gramps.gui.dbman` that carry no GTK/GUI dependency, so the
+message-assembly logic for the RCS (archive) subprocesses can be unit tested
+without a display.
+"""
+
+
+def read_subprocess_messages(proc):
+    """
+    Assemble the text emitted on a subprocess's stderr pipe into one message.
+
+    The RCS helper subprocesses in :mod:`gramps.gui.dbman` open ``stderr`` with
+    a plain ``subprocess.PIPE`` (binary mode), so ``proc.stderr.readlines()``
+    yields ``bytes`` objects.  Joining those directly into a ``str`` raises
+    ``TypeError: sequence item 0: expected str instance, bytes found`` whenever
+    the subprocess writes anything to stderr.  Decode each line to ``str``
+    first; ``errors="replace"`` keeps a non-UTF-8 RCS diagnostic from turning
+    into a secondary ``UnicodeDecodeError``.
+
+    :param proc: a started subprocess whose ``stderr`` is a readable binary
+                 pipe (``subprocess.Popen(..., stderr=subprocess.PIPE)``).
+    :returns: the decoded, newline-joined stderr text (``str``).
+    """
+    return "\n".join(line.decode(errors="replace") for line in proc.stderr.readlines())
