index 0000000000..ff141878a5
--- /dev/null
+++ b/gramps/gen/test/relationship_test.py
@@ -0,0 +1,150 @@
+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+#
+# Gramps - a GTK+/GNOME based genealogy program
