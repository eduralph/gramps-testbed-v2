index 0000000000..b3f932d915
--- /dev/null
+++ b/gramps/gen/utils/test/db_test.py
@@ -0,0 +1,147 @@
+#!/usr/bin/env python
+# -*- coding: utf-8 -*-
+#
+# Gramps - a GTK+/GNOME based genealogy program
+#
+# Copyright (C) 2025
