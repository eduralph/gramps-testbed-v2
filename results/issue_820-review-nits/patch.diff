+"""
+Path predicates shared by the addon plugin-registration tests.
+
+Deliberately free of Gramps / GI imports so the predicates can be unit-tested
+without booting the plugin system or needing a display.
+"""
+
+# ------------------------
+# Python modules
+# ------------------------
+import os
+
+
+def is_in_addons_tree(fpath: str, addons_root: str) -> bool:
+    """Return whether ``fpath`` lies inside the ``addons_root`` directory tree.
+
+    This is a path-*prefix* check, not a substring test: a sibling directory
+    whose name merely starts with ``addons_root`` (e.g. ``addons-source-6.1``
+    next to ``addons-source``) must **not** be treated as inside the tree.
+
+    :param fpath: A plugin's ``fpath`` (its ``.gpr.py`` directory); may be empty.
+    :param addons_root: Absolute path to the addons-source repository root.
+    :returns: ``True`` iff ``fpath`` is a path beneath ``addons_root``.
+    """
+    if not fpath:
+        return False
+    return fpath.startswith(addons_root + os.sep)
