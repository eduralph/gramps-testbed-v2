+"""
+Validity predicate for a name's call name.
+
+A call name must be one of the given names that are normally used.  Whether a
+call name is valid therefore depends on *both* the call name and the current
+given name -- a change to either field can flip the result.  Keeping the
+predicate here (free of any GUI / ``gi`` imports) lets the Name editor and its
+tests share a single implementation.
+"""
+
+
+def call_name_is_valid(call_name, given_name):
+    """
+    Return True if ``call_name`` is part of ``given_name``.
+
+    The given name is split on whitespace and on hyphens, so each individual
+    given (including the components of a hyphenated given) is an acceptable
+    call name.  An empty call name is never valid.
+
+    :param call_name: the call name to check
+    :type call_name: str
+    :param given_name: the current given name(s)
+    :type given_name: str
+    :rtype: bool
+    """
+    valid = given_name.split()
+    for item in list(valid):
+        valid += item.split("-")
+    return call_name in valid
