index 0000000000..e05ae0a008
--- /dev/null
+++ b/gramps/gui/editors/test/editname_test.py
@@ -0,0 +1,86 @@
+#
+# Gramps - a GTK+/GNOME based genealogy program
+#
+# Copyright (C) 2026  Gramps developers
+#
+# This program is free software; you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation; either version 2 of the License, or
+# (at your option) any later version.
+#
+# This program is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License along
+# with this program; if not, see <https://www.gnu.org/licenses/>.
+#
+
+"""
+Unittest for the call-name validity predicate used by the Name editor
+(``gramps/gui/editors/editname.py``), regression test for bug 12110.
+
+The Name editor marks the Call name field red when the call name is not part
+of the current given name.  ``EditName._validate_call`` delegates that decision
+to :func:`gramps.gen.utils.callname.call_name_is_valid`, the same predicate
+exercised here -- so this drives the production validity check (no parallel
+copy), import-light (no ``gi`` / ``gramps.gui``), against *changing given-name
+input*.
+
+The defect (12110) was that the indicator went stale because the check only
+re-fired on a Call-field change, never on a Given-field change.  The editor's
+fix re-runs this predicate whenever the given name changes; these cases assert
+the predicate it re-runs yields the right red->black and black->red transition
+for the bug's two scenarios.
+"""
+
+import unittest
+
+from gramps.gen.utils.callname import call_name_is_valid
+
+
+class CallNameValidityTest(unittest.TestCase):
+    def test_call_in_given_is_valid(self):
+        """A call name that is one of the given names is valid (black)."""
+        self.assertTrue(call_name_is_valid("Marc", "Marc"))
+        self.assertTrue(call_name_is_valid("Lee", "Marc Lee"))
+
+    def test_call_not_in_given_is_invalid(self):
+        """A call name absent from the given name is invalid (red)."""
+        self.assertFalse(call_name_is_valid("Jon", ""))
+        self.assertFalse(call_name_is_valid("Paul", "Marc"))
+
+    def test_empty_call_name_is_invalid(self):
+        """An empty call name is never valid."""
+        self.assertFalse(call_name_is_valid("", ""))
+        self.assertFalse(call_name_is_valid("", "Marc"))
+
+    def test_hyphenated_given_components_are_valid(self):
+        """Each component of a hyphenated given name is an acceptable call."""
+        self.assertTrue(call_name_is_valid("Anne", "Jean-Anne"))
+        self.assertTrue(call_name_is_valid("Jean-Anne", "Jean-Anne"))
+
+    def test_red_to_black_when_given_filled_to_match(self):
+        """Bug 12110 case 1: Call='Jon', given empty (red) -> given='Jon'.
+
+        Re-running the predicate against the *new* given name must flip the
+        result from invalid (red) to valid (black) -- the stale-red case.
+        """
+        call = "Jon"
+        self.assertFalse(call_name_is_valid(call, ""))  # before: red
+        self.assertTrue(call_name_is_valid(call, "Jon"))  # after: black
+
+    def test_black_to_red_when_given_changed_away(self):
+        """Bug 12110 case 2: given='Marc', Call='Marc' (black) -> given='Paul'.
+
+        Re-running the predicate against the *new* given name must flip the
+        result from valid (black) to invalid (red) -- the stale-black case.
+        """
+        call = "Marc"
+        self.assertTrue(call_name_is_valid(call, "Marc"))  # before: black
+        self.assertFalse(call_name_is_valid(call, "Paul"))  # after: red
+
+
+if __name__ == "__main__":
+    unittest.main()
