+"""
+Call-name validity helpers used by the Name editor.
+
+The Name editor marks the *Call name* field red when the call name is not one
+of the given names that are normally used.  That decision depends on **both**
+the call name and the current given name (bug 12110): a change to *either*
+field can flip the result.  The two helpers here -- the validity predicate and
+the re-validation trigger -- are the single, GUI-free implementation the editor
+(``gramps/gui/editors/editname.py``) routes through, so its tests can exercise
+the same code without importing ``gi`` / ``gramps.gui``.
+"""
+
+
+def call_name_is_valid(call_name, given_name):
+    """
+    Return True if ``call_name`` is part of ``given_name``.
+
+    The given name is split on whitespace and on hyphens, so each individual
+    given (including the components of a hyphenated given) is an acceptable
+    call name.  An empty call name is never valid.
+
+    :param call_name: the call name to check
+    :type call_name: str
+    :param given_name: the current given name(s)
+    :type given_name: str
+    :rtype: bool
+    """
+    valid = given_name.split()
+    for item in list(valid):
+        valid += item.split("-")
+    return call_name in valid
+
+
+def revalidate_call(call_field):
+    """
+    Re-run the call field's validation (bug 12110).
+
+    The call-name validity indicator depends on the current given name, so a
+    change to the given name must re-fire the call field's validation to keep
+    the red/black indicator in sync -- otherwise it goes stale.  This is the
+    body of the Name editor's given-name ``changed`` callback, factored out so
+    production and the regression test drive one implementation.
+
+    ``force=True`` makes the validatable entry re-run its ``validate`` handler
+    even though the call text itself did not change.
+
+    :param call_field: the editor's monitored call-name entry (has an ``obj``
+        attribute that is a validatable entry widget)
+    """
+    call_field.obj.validate(force=True)
