+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License along
+# with this program; if not, see <https://www.gnu.org/licenses/>.
+#
+
+"""
+Regression test for bug 12110 -- the Name editor's Call-name indicator must
+track the *current* given name.
+
+The Name editor (``gramps/gui/editors/editname.py``) marks the Call field red
+when the call name is not part of the given name.  The defect: that check fired
+only when the *Call* field changed, never when the *Given* field changed, so
+the red/black indicator went stale.
+
+These tests drive the **production** code the editor routes through -- no
+parallel copy (principles 3.4):
+
+  * ``EditName._validate_call`` delegates the validity decision to
+    ``gramps.gen.utils.callname.call_name_is_valid`` (editname.py: the
+    ``if call_name_is_valid(...)`` branch);
+  * ``EditName._revalidate_call`` -- the given-name ``changed`` callback added
+    by the fix (``changed=self._revalidate_call`` on ``given_field``) --
+    delegates to ``gramps.gen.utils.callname.revalidate_call``, which forces
+    the call field's validation to re-run.
+
+Both helpers are GUI-free, so this runs headless (no ``gi`` / ``gramps.gui``
+import).  The ``test_given_change_*`` cases wire the production
+``revalidate_call`` trigger to the production ``call_name_is_valid`` predicate
+through a faithful stand-in for the GTK validatable entry, and assert the
+indicator flips on a *given-name* change -- the end result the bug asks for.
+"""
+
+import unittest
+from types import SimpleNamespace
+
+from gramps.gen.utils.callname import call_name_is_valid, revalidate_call
+
+
+class _FakeValidatableEntry:
+    """Minimal stand-in for the editor's Gtk validatable call-name entry.
+
+    Mirrors the only behaviour the fix relies on: ``validate(force=True)``
+    re-runs the call-name validity check against the *current* given name and
+    records whether the entry is invalid (would show red).  In production the
+    real widget emits a ``validate`` signal that reaches
+    ``EditName._validate_call``; here the handler calls the same predicate that
+    method calls, so the test exercises the production decision, not a copy.
+    """
+
+    def __init__(self, call_text, get_given):
+        self.text = call_text
+        self._get_given = get_given
+        self.invalid = None  # None until validated; True == red, False == black
+
+    def validate(self, force=False):
+        self.invalid = not call_name_is_valid(self.text, self._get_given())
+
+
+class CallNamePredicateTest(unittest.TestCase):
+    """The validity predicate ``_validate_call`` uses, against changing input."""
+
+    def test_call_in_given_is_valid(self):
+        self.assertTrue(call_name_is_valid("Marc", "Marc"))
+        self.assertTrue(call_name_is_valid("Lee", "Marc Lee"))
+
+    def test_call_not_in_given_is_invalid(self):
+        self.assertFalse(call_name_is_valid("Jon", ""))
+        self.assertFalse(call_name_is_valid("Paul", "Marc"))
+
+    def test_empty_call_name_is_invalid(self):
+        self.assertFalse(call_name_is_valid("", ""))
+        self.assertFalse(call_name_is_valid("", "Marc"))
+
+    def test_hyphenated_given_components_are_valid(self):
+        self.assertTrue(call_name_is_valid("Anne", "Jean-Anne"))
+        self.assertTrue(call_name_is_valid("Jean-Anne", "Jean-Anne"))
+
+
+class RevalidateCallTest(unittest.TestCase):
+    """The given-name ``changed`` callback re-fires the call field validation.
+
+    ``revalidate_call`` is the body of ``EditName._revalidate_call`` -- the hook
+    the fix wires to the given field.  Driving it here proves the
+    ``validate(force=True)`` trigger the original code lacked.
+    """
+
+    def test_revalidate_forces_call_field_validation(self):
+        """revalidate_call must call validate(force=True) on the call widget."""
+        calls = []
+        widget = SimpleNamespace(validate=lambda force=False: calls.append(force))
+        revalidate_call(SimpleNamespace(obj=widget))
+        self.assertEqual(calls, [True])
+
+    def test_given_change_red_to_black(self):
+        """Bug 12110 case 1: Call='Jon', given empty (red) -> given='Jon'.
+
+        Re-validating on the given-name change (via the production
+        ``revalidate_call`` trigger) must flip the indicator red -> black
+        without the user re-touching the Call field.
+        """
+        given = {"text": ""}
+        widget = _FakeValidatableEntry("Jon", lambda: given["text"])
+        call_field = SimpleNamespace(obj=widget)
+
+        widget.validate(force=True)  # initial check: empty given
+        self.assertTrue(widget.invalid)  # red
+
+        given["text"] = "Jon"  # user edits the Given field
+        revalidate_call(call_field)  # production given-changed hook
+        self.assertFalse(widget.invalid)  # now black
+
+    def test_given_change_black_to_red(self):
+        """Bug 12110 case 2: given='Marc', Call='Marc' (black) -> given='Paul'.
+
+        Re-validating on the given-name change must flip black -> red.
+        """
+        given = {"text": "Marc"}
+        widget = _FakeValidatableEntry("Marc", lambda: given["text"])
+        call_field = SimpleNamespace(obj=widget)
+
+        widget.validate(force=True)  # initial check: given matches
+        self.assertFalse(widget.invalid)  # black
+
+        given["text"] = "Paul"  # user edits the Given field
+        revalidate_call(call_field)  # production given-changed hook
+        self.assertTrue(widget.invalid)  # now red
+
+
+if __name__ == "__main__":
+    unittest.main()
